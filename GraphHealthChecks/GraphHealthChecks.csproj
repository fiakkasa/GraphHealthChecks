<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageId>$(MSBuildProjectName)</PackageId>
    <Version>7.0.0</Version>
    <Authors>Adamos Fiakkas</Authors>
    <Description>Graph Health Checks for HotChocolate</Description>
    <Copyright>Adamos Fiakkas</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/fiakkasa/GraphHealthChecks</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fiakkasa/GraphHealthChecks</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" pack="true" PackagePath="."/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.Types" Version="16.7.5"/>
  </ItemGroup>

  <!-- note: target explicitly -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0' Or '$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GraphHealthChecks.Tests"/>
  </ItemGroup>

</Project>